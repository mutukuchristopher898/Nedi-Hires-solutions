# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API). Never commit .env.local — it's already gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Smile Identity credentials for automated document/selfie verification
# (server-only — deliberately NOT prefixed NEXT_PUBLIC_, never exposed to the
# browser). Get these from your Smile Identity portal after signing up.
# Verification fails soft to "pending" (manual admin review) if unset.
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=

# Gates the apply_verification_result() database function, which is the only
# way verification_status can be written. Server-only — deliberately NOT
# prefixed NEXT_PUBLIC_. Must match the value hashed into app_capability_keys
# by migration 20260903120000. This is NOT a service_role key: it grants one
# power (recording a verification result) and no RLS bypass anywhere else.
VERIFICATION_WRITER_SECRET=
